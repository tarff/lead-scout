# lead-scout — environment template
# Copy to `.env` (gitignored) for local runs. In CI these live as GitHub Actions secrets.
# NEVER commit real values. `.env`, *service-account*.json and *sa*.json are gitignored.

# --- Secrets (GitHub Actions: repo Settings → Secrets and variables → Actions) ---

# Single Google Cloud API key, restricted to Places API (New) + PageSpeed Insights API.
GOOGLE_API_KEY=

# OpenRouter API key (drafting). Model slug is config, default anthropic/claude-haiku-4.5.
OPENROUTER_API_KEY=

# Google Sheets service-account credentials.
#   Local: path to the downloaded JSON key file (gitignored), e.g. ./service-account.json
#   CI:    the full JSON contents pasted into the GOOGLE_SHEETS_SA_JSON secret.
GOOGLE_SHEETS_SA_JSON=./service-account.json

# The target Google Sheet ID (from its URL: /spreadsheets/d/<SHEET_ID>/edit).
SHEET_ID=

# --- Non-secret runtime toggles (real config file added in the build phase) ---

# OpenRouter model slug — confirmed on OpenRouter 2026-06-22.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Dry-run: full pipeline, no Sheet writes, no LLM calls. Use for first runs.
DRY_RUN=true
